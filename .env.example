# Configuration ShopLite
# Copier ce fichier en .env puis adapter les valeurs.
# Le vrai fichier .env ne doit jamais etre commite (voir .gitignore).

# Application
NODE_ENV=development
API_PORT=3000
APP_VERSION=dev

# Ports exposes par le proxy nginx
HTTP_PORT=8080
HTTP_PORT_STAGING=8081

# Base de donnees PostgreSQL (valeurs d'exemple, pas de vrai secret)
POSTGRES_DB=shoplite
POSTGRES_USER=shoplite
POSTGRES_PASSWORD=change_me_en_local
DATABASE_URL=postgres://shoplite:change_me_en_local@db:5432/shoplite

# Niveau de logs: debug, info, warn, error
LOG_LEVEL=info
